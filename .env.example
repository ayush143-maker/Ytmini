# Copy these into Vercel -> Project Settings -> Environment Variables.
# Never put a secret/service_role key here or in frontend code.

# Required: your AyuTube Supabase project URL (no path, no trailing slash)
SUPABASE_URL=https://ydpeuorhetnehpssxhao.supabase.co

# Required: the PUBLISHABLE key (starts with sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: comma-separated Piped API base URLs you have verified.
# They are tried first, then the built-in defaults.
PIPED_INSTANCES=
